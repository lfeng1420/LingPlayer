    <x:String x:Key="ThemeLight">Hell</x:String>
    <x:String x:Key="ThemeDark">Dunkel</x:String>
    <x:String x:Key="ThemeFollowSystem">System folgen</x:String>
    <x:String x:Key="TransparencyEffect">Transparenzeffekt</x:String>
    <x:String x:Key="TransparencyEffectSettingDesc">Wird auf das Haupt- und Minifenster angewendet.&#xA;Einige Effekte werden möglicherweise nicht auf der aktuellen Plattform unterstützt</x:String>
    <x:String x:Key="WindowsRenderType">Rendermodus</x:String>
    <x:String x:Key="WindowsRenderTypeDesc">Bei Anzeigeproblemen den Rendermodus wechseln.&#xA;Ein Neustart ist erforderlich</x:String>
    <x:String x:Key="WindowsRenderDefault">Adaptiv</x:String>
    <x:String x:Key="WindowsRenderDefaultDesc">Wählt automatisch den passenden Rendermodus</x:String>
