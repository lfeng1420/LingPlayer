    <x:String x:Key="OverlayLightOpacity">Overlay-Deckkraft (hell)</x:String>
    <x:String x:Key="OverlayDarkOpacity">Overlay-Deckkraft (dunkel)</x:String>
    <x:String x:Key="OverlayLightOpacityDesc">Overlay verbessert Lesbarkeit im hellen Design. Zu niedrige Werte erschweren das Lesen</x:String>
    <x:String x:Key="PlayingOverlayOpacityDesc">Overlay dunkelt helle Hintergründe im dunklen Design ab und hellt dunkle im hellen Design auf</x:String>
    <x:String x:Key="CollaboratorArtistsVisible">Gastkünstler auf Künstlerseite anzeigen</x:String>
